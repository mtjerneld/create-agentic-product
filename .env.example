# Kopiera den här filen till .env i projektroten och fyll i din nyckel.
# .env är gitignored och checkas aldrig in.

# Krävs för att köra agent-teamet (Claude API).
ANTHROPIC_API_KEY=sk-ant-...

# Valfritt: modell för agenterna. Standard är claude-sonnet-4-6.
# TEAM_MODEL=claude-sonnet-4-6

# Valfritt: output-token-tak. Höj om leveranser blir avhuggna, sänk för att
# spara kostnad. Standardvärden inom parentes.
# TEAM_MAX_TOKENS_AGENT=12000      # en agents leverans
# TEAM_MAX_TOKENS_DELIVERY=20000   # slutleveransen
# TEAM_MAX_TOKENS_KNOWLEDGE=8000   # kunskapsbasen
# TEAM_MAX_TOKENS_TEAM=4096        # team-förslaget

# Valfritt: port för webbservern. Standard är 8000.
# PORT=8000
