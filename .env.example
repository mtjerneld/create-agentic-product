# Kopiera den här filen till .env i projektroten och fyll i din nyckel.
# .env är gitignored och checkas aldrig in.

# Krävs för att köra agent-teamet (Claude API).
ANTHROPIC_API_KEY=sk-ant-...

# Valfritt: modell för agenterna. Standard är claude-sonnet-4-6.
# TEAM_MODEL=claude-sonnet-4-6

# Valfritt: port för webbservern. Standard är 8000.
# PORT=8000
